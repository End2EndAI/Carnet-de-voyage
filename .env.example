# Copiez ce fichier en .env.local pour le développement,
# et renseignez les mêmes variables dans Vercel > Settings > Environment Variables.

# Supabase — Project Settings > API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Google Maps — APIs à activer : Maps JavaScript API + Places API (New)
VITE_GOOGLE_MAPS_API_KEY=AIza...

# Facultatif — Map ID pour un style de carte personnalisé
# (par défaut : DEMO_MAP_ID, qui fonctionne sans configuration)
VITE_GOOGLE_MAPS_MAP_ID=

# OpenAI — pour le bouton "Générer avec l'IA" du formulaire (api/generate-idea.js).
# IMPORTANT : à renseigner UNIQUEMENT dans Vercel > Settings > Environment Variables
# (jamais en VITE_..., sinon la clé finirait dans le bundle JS envoyé au navigateur).
# Cette variable n'a pas besoin d'être dans votre .env.local : la fonction
# api/generate-idea.js ne tourne pas avec `npm run dev`, seulement via `vercel dev`
# ou une fois déployée sur Vercel.
OPENAI_API_KEY=sk-...
