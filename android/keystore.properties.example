# Copiez ce fichier en android/keystore.properties (gitignoré) sur la machine
# qui produit l'AAB de publication. Ne le commitez jamais.
#
# Créer la clé d'upload une seule fois, puis la sauvegarder hors du poste
# (la perdre interdit toute mise à jour de l'app sur le Play Store) :
#
#   keytool -genkeypair -v -keystore android/carnet-upload.keystore \
#     -alias upload -keyalg RSA -keysize 2048 -validity 10000
#
# Chemin relatif à android/app/, ou chemin absolu.
storeFile=../carnet-upload.keystore
storePassword=
keyAlias=upload
keyPassword=
