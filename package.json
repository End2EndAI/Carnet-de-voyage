{
  "name": "carnet-de-voyage",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Carnets de voyage multi-comptes : étapes, idées de visite, verdicts et carte.",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:prod": "npm audit --omit=dev",
    "test:schema": "vitest run tests/schema.test.js",
    "test:rls": "npx supabase db reset --local >/dev/null && npx supabase test db supabase/tests/rls.sql",
    "test:e2e": "npm run build && playwright test",
    "test:all": "npm run audit:prod && npm test && npm run test:schema && npm run test:rls && npm run test:e2e"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.48.0",
    "openai": "^7.8.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "undici": "^7.29.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "supabase": "^2.116.0",
    "tailwindcss": "^3.4.17",
    "vercel": "^59.10.0",
    "vite": "^6.0.7",
    "vitest": "^4.1.11"
  }
}
